# 复制为 .env 后使用随机密码替换；生产环境绝不能保留示例值。
DB_PASSWORD=replace-with-random-database-password
REDIS_PASSWORD=replace-with-random-redis-password
BOOTSTRAP_PASSWORD=replace-with-random-admin-password
CORS_ORIGINS=https://oa.example.com

# 可选：服务端 FCM 服务账号文件路径（或使用 GOOGLE_APPLICATION_CREDENTIALS）
# 只在运行机器设置；私钥和整份服务账号 JSON 绝不能提交。空值时仅消息中心可用。
FCM_CREDENTIALS=
